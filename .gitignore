# LaTeX build intermediates. No compiled PDF is committed either: CI typesets
# paper/methods/manuscript.tex and attaches the PDF to every release.
paper/**/*.aux
paper/**/*.bbl
paper/**/*.bcf
paper/**/*.blg
paper/**/*.log
paper/**/*.out
paper/**/*.run.xml
paper/**/*.toc
paper/**/*.fls
