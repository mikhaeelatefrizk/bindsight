{% extends "base.html.j2" %}
{% block title %}Evidence — bindsight{% endblock %}

{% block content %}
<h1>Evidence</h1>
<p class="lede">
  Everything on this page is read from <code>benchmarks/</code> in the
  repository — the same files the manuscripts cite. Nothing is illustrative,
  recomputed on the fly, or typed by hand.
</p>

{% if not study and not designer %}
  <div class="note note--warn">
    <span class="note__glyph" aria-hidden="true">!</span>
    <div class="note__body">
      <p><strong>No evidence tree in this install.</strong> <code>benchmarks/</code>
      ships with the repository rather than the wheel.</p>
      <p class="small"><a href="{{ github }}/tree/main/benchmarks">Read it on GitHub →</a></p>
    </div>
  </div>
{% endif %}

{% if study %}
<h2 id="discovery">Does it resurface antigens we already trust?</h2>
<p class="prose">
  <strong>{{ study.n_scored }} antigen-cohort pairs across {{ study.n_projects }}
  real TCGA projects.</strong> Each cohort is every patient in the project who
  contributed both a primary tumour and a solid-tissue normal, contrasted
  pairwise on the patient. That is a subset of the project — a tumour with no
  matched normal is not in it — and the subset is chosen by sample availability,
  never by the antigen under test. No cohort is stratified by any biomarker.
</p>

<h3>Recall, on the pre-registered denominator</h3>
{% set cascade = (study.recall_cascade or {}).get('all', {}) %}
{% set w20 = ((cascade.get('at_k') or {}).get('recall@20') or {}).get('wilson') or {} %}
<div class="card">
  <div class="row">
    <div class="stat">
      <span class="stat__label">Recall @ 20</span>
      <span class="stat__value">{{ w20.get('numerator', ABSENT) }}/{{ w20.get('denominator', ABSENT) }}</span>
      <span class="stat__ci">{{ interval(w20.get('low'), w20.get('high'), digits=2, confidence=w20.get('confidence')) }}</span>
      <span class="stat__note">
        Approved-agent antigens only — the tiers the study pre-registered.
      </span>
    </div>
  </div>
  {% if recall %}
    <div data-chart="bars" data-spec='{{ tojson(recall) }}' style="margin-top:1rem"></div>
    <p class="chart__caption">
      Each bar is a cutoff; the figure beside it is the numerator over the
      denominator, not a percentage on its own.
    </p>
  {% endif %}
</div>

{% if study.headline %}
{% set top = study.headline %}
<h3>The best-ranked antigen, and why it is shown separately</h3>
<div class="card">
  <div class="row">
    <div class="stat">
      <span class="stat__label">{{ top.symbol }} rank</span>
      <span class="stat__value">{{ top.rank }}</span>
      <span class="stat__of">of {{ fmt_int(top.shortlist_size) }} candidates in
        {{ top.project|replace('TCGA-','') }}</span>
    </div>
    <div class="stat">
      <span class="stat__label">log2 fold change</span>
      <span class="stat__value">{{ fmt(top.log2fc) }}</span>
      <span class="stat__ci">
        {% if top.get('lfc_se') is not none %}± {{ fmt(top.lfc_se) }} (SE){% else %}{{ ABSENT }}{% endif %}
      </span>
    </div>
  </div>

  <div class="note note--info" style="margin-top:1rem">
    <span class="note__glyph" aria-hidden="true">i</span>
    <div class="note__body">
      <p class="small" style="margin:0">
        <strong>{{ top.symbol }} is not in the recall figure above.</strong> Its
        regulatory tier is <code>{{ top.get('tier', ABSENT) }}</code>, and the
        study pre-registered
        <code>{{ study.primary_tiers|join(', ') or ABSENT }}</code> as the primary
        denominator. The two numbers answer different questions and are kept
        apart deliberately: placing them side by side invites a reader to bind
        the “1” in a recall fraction to a rank of 1 for a different antigen.
      </p>
    </div>
  </div>

  {% if top.get('note') %}
    <div class="note note--warn" style="margin-top:.75rem">
      <span class="note__glyph" aria-hidden="true">!</span>
      <div class="note__body">
        <p class="small" style="margin:0">
          <strong>What qualifies this result.</strong> {{ top.note }}
        </p>
      </div>
    </div>
  {% endif %}
</div>
{% endif %}

<h3 id="nulls">Is the ranking doing anything? Two nulls, pointing different ways</h3>
<p class="prose">
  Both are reported. Reporting only the flattering one would make the other the
  finding.
</p>

<div class="grid grid--2">
  <section class="card">
    <h4 class="card__title">
      <span class="badge badge--warn"><span class="badge__glyph" aria-hidden="true">–</span>negative</span>
      Against abundance-matched decoys
    </h4>
    <div class="stat">
      <span class="stat__label">Survive Benjamini-Hochberg</span>
      <span class="stat__value">{{ study.decoy_surviving_correction }}</span>
      <span class="stat__of">of {{ study.decoy_rows|length }} pairs
        ({{ study.decoy_nominal }} nominally significant at 0.05)</span>
    </div>
    <p class="small" style="margin-top:.75rem">
      Each antigen is compared with genes matched to it on abundance and
      dispersion quintile, drawn from the same eligible surfaceome: would a gene
      that merely <em>looks</em> like this antigen have ranked as well?
    </p>
    {% if study.smallest_attainable_decoy_bh is not none %}
      <p class="small muted">
        Read with the panel's resolution in mind: each pair's p is bounded below
        by its own stratum size, so the smallest adjusted value this panel could
        have produced is <strong>{{ fmt(study.smallest_attainable_decoy_bh, 3) }}</strong>.
        Under 0.05 — a pair genuinely could have survived, but only one sitting
        essentially on its floor. A measurement, not a foregone conclusion, and
        not a sensitive one.
      </p>
    {% endif %}
  </section>

  <section class="card">
    <h4 class="card__title">
      <span class="badge badge--ok"><span class="badge__glyph" aria-hidden="true">✓</span>positive</span>
      Against cohorts carrying no panel antigen, and against a permuted indication
    </h4>
    {% set gap = study.indication_gap %}
    {% set spec = study.specificity_null %}
    {% if gap.get('point') is not none %}
      <div class="stat">
        <span class="stat__label">Within-antigen difference</span>
        <span class="stat__value">{{ fmt(gap.point, 3) }}</span>
        <span class="stat__ci">
          {{ interval(gap.low, gap.high, confidence=gap.get('confidence')) }}
          over {{ gap.get('n_clusters', ABSENT) }} antigens — excludes zero
        </span>
      </div>
    {% endif %}
    {% if spec.get('p_value') is not none %}
      {#
        A second analysis, not a p-value for the difference above. The difference
        is a cluster bootstrap over the antigens that appear in the calibration
        cohorts; this is an exact permutation test over the antigens carrying a
        single indication, because the permutation assigns one cohort per antigen.
        The two denominators differ, and stating the p under the difference
        without saying so invited the reader to read it as its significance.
      #}
      <p class="small" style="margin-top:.75rem">
        <strong>A second test, on its own denominator.</strong> Against every
        reassignment of cohorts to antigens, the mean standing is
        <strong>{{ fmt(spec.get('observed'), 3) }}</strong>: exact permutation p =
        <strong>{{ fmt_p(spec.p_value) }}</strong> over
        {{ fmt_int(spec.get('n_permutations')) }} enumerated orderings of
        {{ fmt_int(spec.get('n_antigens')) }} antigens{% if study.specificity_is_at_its_floor %} —
        the floor for this design, so it is as extreme as an exhaustive
        enumeration of this panel can show rather than vanishingly small{% endif %}.
        Restricted to antigens with a single indication, because the permutation
        assigns one cohort to each. This p is not the significance of the
        difference above, which is reported with an interval and no p.
      </p>
    {% endif %}
    {% if nulls %}
      <div data-chart="forest" data-spec='{{ tojson(nulls) }}'></div>
    {% endif %}
    <p class="small muted">
      Each antigen is its own control: the comparison is within antigen, not
      between two groups of them.
    </p>
  </section>
</div>

<h3>Every pair</h3>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Antigen</th><th>Cohort</th>
        <th class="num">log2FC</th><th class="num">padj</th>
        <th class="num">Rank</th>
        <th class="num"><abbr title="Where it would have ranked with every gate removed">Counterfactual</abbr></th>
        <th>Outcome</th>
      </tr>
    </thead>
    <tbody>
    {% for p in study.pairs %}
      <tr>
        <td><strong>{{ p.get('symbol', ABSENT) }}</strong></td>
        <td>{{ p.get('project', ABSENT)|replace('TCGA-','') }}</td>
        <td class="num">{{ fmt(p.get('log2fc')) }}</td>
        <td class="num">{{ fmt_p(p.get('padj')) }}</td>
        <td class="num">
          {% if p.get('rank') is not none %}{{ p.rank }} of {{ fmt_int(p.get('shortlist_size')) }}
          {% else %}{{ ABSENT }}{% endif %}
        </td>
        <td class="num">{{ fmt_int(p.get('counterfactual_rank')) }}</td>
        <td class="small">{{ p.get('outcome_class', ABSENT)|replace('_',' ') }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
<p class="chart__caption">
  A rank is printed with the size of the list it sits in. The counterfactual
  column is what separates “a filter excluded it” from “the ranking placed it low”.
</p>
{% endif %}

{% if designer %}
<h2 id="design">The design half, and the control that withdrew its headline</h2>
<div class="card">
  <div class="row">
    <div class="stat">
      <span class="stat__label">Designs</span>
      <span class="stat__value">{{ fmt_int(designer.n_designs) }}</span>
      <span class="stat__of">from {{ designer.n_trajectories or ABSENT }} backbones</span>
    </div>
    <div class="stat">
      <span class="stat__label">Mean ipTM</span>
      <span class="stat__value">{{ fmt(designer.mean_iptm) }}</span>
      <span class="stat__of">validator {{ designer.validator or ABSENT }}</span>
    </div>
    <div class="stat">
      <span class="stat__label">Hardware</span>
      <span class="stat__value" style="font-size:var(--t-md)">{{ designer.gpu or ABSENT }}</span>
      <span class="stat__of">bindsight {{ designer.bindsight_version or ABSENT }}</span>
    </div>
  </div>

  <div class="withdrawn">
    <strong>success@0.65 is withdrawn as a measure of design quality.</strong>
    A paired control folded every design beside a shuffle of its own sequence —
    same length, same amino-acid composition, only the order destroyed. Under a
    seeded validator averaging five diffusion draws the shuffles cleared the
    customary ipTM 0.65 bar <em>more</em> often than the designs did. The ipTM
    values are real Boltz-2 outputs; what does not follow is that the rate
    measures the designs. The control's predictions were written down before its
    data arrived.
  </div>

  {% if structures %}
    <h3 class="card__title" style="margin-top:1.5rem">The complexes themselves</h3>
    <p class="small muted" style="margin-top:0">
      Boltz-2's predicted binder&ndash;target complex for each design, as committed
      to this repository. Rotate it. The numbers above are summaries of these
      files, not of anything else.
    </p>
    <div class="field" style="max-width:32rem">
      <label for="binder-pick">Design</label>
      <select id="binder-pick">
        {% for b in structures %}
          <option value="{{ b.binder_id }}">
            {{ b.binder_id }} — ipTM {{ fmt(b.iptm) }}
          </option>
        {% endfor %}
      </select>
    </div>
    <div id="viewer" class="viewer" role="img"
         aria-label="Three-dimensional view of the predicted binder-target complex">
      <p class="viewer__fallback small muted">
        The structure viewer needs JavaScript. Every complex is also committed as
        mmCIF under <code>benchmarks/designer_benchmark/</code>, which is the file
        this viewer reads.
      </p>
    </div>
    <div class="viewer-legend">
      <span><span class="swatch" style="background:#9aa5b1"></span>
        chain&nbsp;<strong>T</strong> — the target</span>
      <span><span class="swatch" style="background:#0f7d73"></span>
        chain&nbsp;<strong>B</strong> — the designed binder</span>
    </div>
    <p class="chart__caption">
      The chain letters are in the file, so the two are distinguishable without
      the colours — on a projector, in greyscale, and to a reader who does not
      separate teal from grey.
    </p>
  {% endif %}

  {% if paired %}
    <div data-chart="pairedStrip" data-spec='{{ tojson(paired) }}' style="margin-top:1rem"></div>
    <p class="chart__caption">
      One line per pair, so the pairing is visible rather than two clouds. A red
      line is a pair whose shuffle scored higher than the design it came from.
    </p>
  {% endif %}
</div>
{% endif %}

<h2>Reproducing any of this</h2>
<p class="prose">
  Three tiers. The first needs nothing but a clone and runs in seconds; it
  regenerates the published pages from committed files and should produce no
  diff at all.
</p>
<pre><code>git clone {{ github }}
cd bindsight
pip install -e ".[discover,report]"
python scripts/build_docs_results.py   # rewrites the published pages; nothing should change</code></pre>
<p class="small muted">
  Re-running the study needs network and a few CPU-hours; re-running the design
  needs a GPU. Both chains are documented in the repository.
</p>
{% endblock %}

{% block scripts %}
{% if structures %}
<script src="/static/vendor/3Dmol-min.js"></script>
<script>
// Vendored, not from a CDN: `bindsight ui` is meant to work on a laptop with no
// connection once installed, and a page that silently needs one does not.
(function () {
  // bindsight writes the designed chain as B and the target it was designed
  // against as T. tests/test_web_ui.py asserts that of every committed
  // structure, so if it ever stops being true this stops being a silent
  // mis-colouring and becomes a failing test.
  var BINDER_CHAIN = "B";
  var host = document.getElementById("viewer");
  var pick = document.getElementById("binder-pick");
  if (!host || !pick || typeof $3Dmol === "undefined") return;

  // Composed as nodes rather than markup, for the reason the fetch handler
  // below gives: a message that later starts carrying something a server said
  // must not be interpolated into innerHTML.
  function replaceViewerWith(text) {
    host.innerHTML = "";
    var note = document.createElement("p");
    note.className = "small";
    note.style.padding = "1rem";
    note.textContent = text;
    var where = document.createElement("p");
    where.className = "small muted";
    where.style.padding = "0 1rem 1rem";
    where.textContent =
      "Every complex is committed as mmCIF under " +
      "benchmarks/designer_benchmark/, which is the file this viewer reads.";
    host.appendChild(note);
    host.appendChild(where);
  }

  // WebGL is unavailable in more places than it looks: locked-down machines,
  // remote desktops, some VMs, browsers with hardware acceleration off. There
  // `createViewer` does not throw -- it returns a viewer over a canvas with a
  // dead context, so the page drew a white rectangle under a caption promising
  // a rotatable complex and said nothing. The rule is the one the fetch
  // handler below states: a blank viewer and a design that produced nothing
  // are different facts and must not look the same.
  function webglAvailable() {
    try {
      var probe = document.createElement("canvas");
      return !!(probe.getContext("webgl2") || probe.getContext("webgl"));
    } catch (e) {
      return false;
    }
  }

  if (!webglAvailable()) {
    replaceViewerWith(
      "This browser cannot draw 3-D structures: WebGL is unavailable or " +
        "switched off. The structures are here, the viewer is not."
    );
    return;
  }

  host.innerHTML = "";
  var viewer;
  try {
    viewer = $3Dmol.createViewer(host, { backgroundColor: "white" });
  } catch (e) {
    replaceViewerWith("Could not start the structure viewer: " + String(e && e.message));
    return;
  }
  if (!viewer) {
    replaceViewerWith("Could not start the structure viewer.");
    return;
  }

  function show(id) {
    fetch("/api/structure/" + encodeURIComponent(id))
      .then(function (r) {
        if (!r.ok) throw new Error("no structure for " + id);
        return r.text();
      })
      .then(function (cif) {
        viewer.clear();
        var model = viewer.addModel(cif, "cif");
        // An mmCIF the parser did not understand yields a model with no atoms,
        // and 3Dmol renders that as an empty canvas without complaint -- the
        // same white rectangle a reader would get from a design that produced
        // nothing. Counted rather than assumed, for the reason the catch block
        // below gives.
        var atoms = 0;
        try {
          atoms = model && model.selectedAtoms ? model.selectedAtoms({}).length : 0;
        } catch (e) {
          atoms = 0;
        }
        if (!atoms) {
          throw new Error("the structure file for " + id + " parsed to no atoms");
        }
        // Paint everything first, then override the binder. Styling named
        // chains only meant a file whose chains are named something else kept
        // 3Dmol's default line style and rendered as a wireframe haze -- with
        // no error, and under a caption claiming it was grey cartoon.
        viewer.setStyle({}, { cartoon: { color: "#9aa5b1" } });
        viewer.setStyle({ chain: BINDER_CHAIN }, { cartoon: { color: "#0f7d73" } });
        viewer.zoomTo();
        viewer.render();
      })
      .catch(function (err) {
        // Said plainly. A viewer that stays blank is indistinguishable from a
        // design that produced nothing, and those are different facts.
        //
        // Built as a node with textContent rather than assembled into
        // innerHTML. The message is composed here today, but an error string
        // is exactly the kind of value that later starts carrying something a
        // server said, and by then the interpolation looks harmless.
        host.innerHTML = "";
        var note = document.createElement("p");
        note.className = "small";
        note.style.padding = "1rem";
        note.textContent = "Could not load this structure: " + String(err && err.message);
        host.appendChild(note);
      });
  }

  pick.addEventListener("change", function () { show(pick.value); });
  show(pick.value);
})();
</script>
{% endif %}
{% endblock %}
