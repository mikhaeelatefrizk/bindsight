<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>bindsight report — {{ run_name }}</title>
<style>{{ css|safe }}</style>
</head>
<body>
<header>
  <div class="inner">
    <h1>bindsight report</h1>
    <p class="subtitle">RNA-seq → de novo protein binder candidates, with end-to-end provenance.</p>
    <div class="meta">
      run: <strong>{{ run_name }}</strong> &middot;
      id: <code>{{ run_id }}</code> &middot;
      created: {{ created_at }}
    </div>
  </div>
</header>

<main>

{% if failed_stages %}
<section id="incomplete">
  <h2>Incomplete run &mdash; a stage failed</h2>
  <div class="note note--err"><span class="note__glyph" aria-hidden="true">&#10007;</span><div class="note__body"><p style="margin:0">
    <strong>These results are incomplete: a pipeline stage failed, so this is not a
    real negative result.</strong>
    The run stopped at
    {% for f in failed_stages %}<code>{{ f.name }}</code>{% if not loop.last %}, {% endif %}{% endfor %},
    which means the counts and tables below record a crash rather than a
    measurement. Nothing here supports a conclusion &mdash; not even a negative one
    &mdash; until the failure is fixed and the run repeated.
  </p></div></div>
  <div class="table-wrap">
  <table>
    <thead><tr><th>failed stage</th><th>error</th></tr></thead>
    <tbody>
    {% for f in failed_stages %}
      <tr>
        <td><strong>{{ f.name }}</strong></td>
        <td><code>{{ f.error or 'no error detail recorded' }}</code></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

<section>
  <h2>Summary</h2>
  <!-- `.stat`, not a private `.kpi`: the component carries the rule that a
       figure appears with its denominator. Each of these is a survival count,
       and the denominator is the stage before it — which is the shape of the
       funnel and was already on disk. -->
  <div class="row">
    <div class="stat{% if not n_deg %} stat--absent{% endif %}">
      <span class="stat__label">Genes tested</span>
      <span class="stat__value">{{ n_deg or '&mdash;'|safe }}</span>
      <span class="stat__of">rows in the differential-expression table</span>
    </div>
    <div class="stat{% if n_significant is none %} stat--absent{% endif %}">
      <span class="stat__label">Significant DEGs</span>
      <span class="stat__value">{{ n_significant }}</span>
      <span class="stat__of">of {{ n_deg or '&mdash;'|safe }} tested</span>
    </div>
    <div class="stat{% if n_candidates is none %} stat--absent{% endif %}">
      <span class="stat__label">Candidate targets</span>
      <span class="stat__value">{{ n_candidates }}</span>
      <span class="stat__of">of {{ n_significant or '&mdash;'|safe }} significant, after the surfaceome filter</span>
    </div>
    <div class="stat{% if n_epitopes is none %} stat--absent{% endif %}">
      <span class="stat__label">Epitopes</span>
      <span class="stat__value">{{ n_epitopes }}</span>
      <span class="stat__of">of {{ n_candidates or '&mdash;'|safe }} candidates, top-N only</span>
    </div>
  </div>
  {% if failed_stages %}
  <div class="note note--err"><span class="note__glyph" aria-hidden="true">&#10007;</span><div class="note__body"><p style="margin:0">
    The counts above are whatever the crashed run left on disk &mdash; they are not
    measurements. See <a href="#incomplete">Incomplete run</a>.
  </p></div></div>
  {% endif %}
  <div class="note note--info"><span class="note__glyph" aria-hidden="true">i</span><div class="note__body"><p style="margin:0">
    Every number above is one click from its evidence in the
    <a href="#provenance">provenance</a> section. The artifacts on disk
    (Parquet + JSON-LD) are the canonical record &mdash; this HTML is a
    rendered view.
  </p></div></div>
</section>

{% if volcano_b64 %}
<section>
  <h2>Differential expression</h2>
  <p>
    Volcano plot of the differential expression analysis.
    {% if deg_fdr is not none and deg_log2fc is not none %}
    Significant genes (padj&nbsp;&lt;&nbsp;{{ deg_fdr }} and
    |log2FC|&nbsp;&ge;&nbsp;{{ deg_log2fc }}) are highlighted; the dashed lines
    mark those cutoffs.
    {% else %}
    Significant genes are highlighted. This run did not record the cutoffs it
    applied, so no threshold lines are drawn.
    {% endif %}
  </p>
  <img class="plot" src="data:image/png;base64,{{ volcano_b64 }}" alt="Volcano plot">
</section>
{% endif %}

<section>
  <h2>Candidate targets</h2>
  <p>
    Genes that survived all filters: significantly differentially expressed,
    surface-exposed (SURFY), antibody-tractable (Open Targets, when enabled),
    and below the safety-event threshold. Top-N rows highlighted.
  </p>
  {% if candidates_table %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>rank</th><th>symbol</th><th>UniProt</th>
        <th>log2FC</th><th>padj</th>
        <th>tractable modalities</th><th>safety events</th>
        <th>has structure</th><th>top-N</th>
      </tr>
    </thead>
    <tbody>
    {% for r in candidates_table %}
      <tr {% if r.rank_in_top_n %}class="top"{% endif %}>
        <td class="num">{{ r.rank }}</td>
        <td><strong>{{ r.symbol or '-' }}</strong></td>
        <td><code>{{ r.uniprot_id or '-' }}</code></td>
        <td class="num">{{ r.log2fc }}</td>
        <td class="num">{{ r.padj }}</td>
        <td>{{ r.tractable_modalities or '-' }}</td>
        <td class="num">{{ r.n_safety_events }}</td>
        <td>
          {% if r.has_alphafold_structure %}<span class="badge badge--ok"><span class="badge__glyph" aria-hidden="true">&#10003;</span>yes</span>
          {% else %}<span class="badge badge--warn"><span class="badge__glyph" aria-hidden="true">!</span>no</span>{% endif %}
        </td>
        <td>
          {% if r.rank_in_top_n %}<span class="badge badge--ok"><span class="badge__glyph" aria-hidden="true">&#10003;</span>top</span>{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% elif failed_stages %}
  <div class="note note--err"><span class="note__glyph" aria-hidden="true">&#10007;</span><div class="note__body"><p style="margin:0">
    No candidate table exists because the run did not finish (see
    <a href="#incomplete">above</a>). The filters were never reached, so loosening
    them would be answering a question that was never asked.
  </p></div></div>
  {% elif candidates_unreadable %}
  <div class="note note--err"><span class="note__glyph" aria-hidden="true">&#10007;</span><div class="note__body"><p style="margin:0">
    The candidate table could not be read, so how many candidates survived is
    unknown. This is not the same as none surviving: nothing was measured.
  </p></div></div>
  {% else %}
  <div class="note"><span class="note__glyph" aria-hidden="true">&#8212;</span><div class="note__body"><p style="margin:0">No candidates survived the filters. Loosen thresholds in the config and re-run.</p></div></div>
  {% endif %}
</section>

<section>
  <h2>Epitopes (top-N targets)</h2>
  <p>
    For each top-N target, the AlphaFoldDB structure path and SURFACE-Bind
    epitope status. <code>surface_bind_site</code> = a vendored targetable site
    (focused design); <code>no_surface_bind_site</code> /
    <code>surface_bind_not_configured</code> = whole-surface design (the
    SURFACE-Bind data tree had no site for this protein, or wasn't vendored
    &mdash; see <code>data/surface_bind/</code> to populate it).
    <code>surface_bind_lookup_failed</code> is different from both: the lookup
    <em>errored</em>, so nothing is known about this protein either way. It is
    not a measured absence of a site.
  </p>
  {% if epitopes_table %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>symbol</th><th>UniProt</th><th>structure</th><th>site id</th><th>status</th></tr>
    </thead>
    <tbody>
    {% for e in epitopes_table %}
      <tr>
        <td><strong>{{ e.symbol or '-' }}</strong></td>
        <td><code>{{ e.uniprot_id or '-' }}</code></td>
        <td><code>{{ e.structure_path or '-' }}</code></td>
        <td>{{ e.site_id or '-' }}</td>
        <td>
          {% if e.epitope_status == 'surface_bind_site' %}
            <span class="badge badge--ok"><span class="badge__glyph" aria-hidden="true">&#10003;</span>{{ e.epitope_status }}</span>
          {% else %}
            <span class="badge badge--warn"><span class="badge__glyph" aria-hidden="true">!</span>{{ e.epitope_status }}</span>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="note"><span class="note__glyph" aria-hidden="true">&#8212;</span><div class="note__body"><p style="margin:0">No top-N epitopes to display.</p></div></div>
  {% endif %}
</section>

<section>
  <h2>Designed binders</h2>
  <p>
    {% if n_binders > binders_table|length %}The {{ binders_table|length }}
    best-scoring of the {{ n_binders }} designs the run produced{% else %}Every
    design the run produced{% endif %}, ranked by the composite score. <code>ipTM</code>
    is the validator's interface confidence (higher is better) and
    <code>PAE-int</code> the predicted interface error in &Aring;ngstr&ouml;m
    (lower is better). <code>passes</code> records each design against the
    configured quality bars; nothing is dropped on their account unless
    <code>apply_thresholds</code> is set.
  </p>
  {% if binders_table %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>rank</th><th>binder</th><th>target</th><th>ipTM</th>
        <th>PAE-int</th><th>score</th><th>passes</th>
        {% if include_binders %}<th>sequence</th>{% endif %}
      </tr>
    </thead>
    <tbody>
    {% for b in binders_table %}
      <tr>
        <td>{{ b.rank or '-' }}</td>
        <td><code>{{ b.binder_id or '-' }}</code></td>
        <td><strong>{{ b.symbol or b.target_uniprot or '-' }}</strong></td>
        <td>{{ b.iptm or '-' }}</td>
        <td>{{ b.pae_interaction or '-' }}</td>
        <td>{{ b.score or '-' }}</td>
        <td>
          {% if b.passes_thresholds == 'pass' %}
            <span class="badge badge--ok"><span class="badge__glyph" aria-hidden="true">&#10003;</span>pass</span>
          {% elif b.passes_thresholds == 'fail' %}
            <span class="badge badge--warn"><span class="badge__glyph" aria-hidden="true">!</span>fail</span>
          {% else %}
            <span class="badge badge--info">{{ b.passes_thresholds or '-' }}</span>
          {% endif %}
        </td>
        {% if include_binders %}<td><code>{{ b.sequence or '-' }}</code></td>{% endif %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% if structure_ids %}
  <h3>The complexes themselves</h3>
  <p class="small muted">
    Drawn from the mmCIF carried inside this file &mdash; no server, no network
    request, nothing to install.
    {% if structures_omitted %}
    The {{ structure_ids|length }} that fit are embedded, best-ranked first;
    {{ structures_omitted }} more {{ 'are' if structures_omitted != 1 else 'is' }}
    in <code>design/_targets/</code>, left out so this stays a file you can send.
    {% endif %}
  </p>
  <div class="field viewer-picker" style="max-width:32rem">
    <label for="binder-pick">Design</label>
    <select id="binder-pick" data-binder-picker>
      {% for bid in structure_ids %}
      <option value="{{ bid }}">{{ bid }}</option>
      {% endfor %}
    </select>
  </div>
  <div id="viewer" class="viewer" role="img" data-binder-viewer
       aria-label="Three-dimensional view of the predicted binder-target complex">
    <p class="viewer__fallback small muted" role="alert">
      The structure viewer needs JavaScript. The complexes are in this file
      either way, as mmCIF.
    </p>
  </div>
  <div class="viewer-legend">
    <span><span class="swatch" style="background:#9aa5b1"></span>
      chain&nbsp;<strong>T</strong> &mdash; the target</span>
    <span><span class="swatch" style="background:#0f7d73"></span>
      chain&nbsp;<strong>B</strong> &mdash; the designed binder</span>
  </div>
  {% elif structures_omitted %}
  <h3>The complexes themselves</h3>
  <p class="small muted">
    None are embedded here. {{ structures_omitted }} predicted complex{{ 'es' if structures_omitted != 1 else '' }}
    would have pushed this file past the size it will carry, so
    {{ 'they are' if structures_omitted != 1 else 'it is' }} in
    <code>design/_targets/</code> instead. Open
    {{ 'them' if structures_omitted != 1 else 'it' }} in any structure viewer,
    or re-render with a larger budget. Saying nothing here would have left this
    section silently missing.
  </p>
  {% endif %}
  {% if not include_binders %}
  <div class="note"><span class="note__glyph" aria-hidden="true">&#8212;</span><div class="note__body"><p style="margin:0">
    Re-render with <code>--include-binders</code> to embed each designed sequence.
  </p></div></div>
  {% endif %}
  {% else %}
  <div class="note"><span class="note__glyph" aria-hidden="true">&#8212;</span><div class="note__body"><p style="margin:0">
    No designed binders in this run. Run <code>bindsight design</code> and
    <code>bindsight rank</code> to produce them.
  </p></div></div>
  {% endif %}
</section>

{% if taxonomy_counts %}
<section>
  <h2>Why candidates dropped (negative-result taxonomy)</h2>
  <p>
    Each of the {{ n_taxonomy }} differentially-expressed genes gets exactly one
    disposition explaining why it did or didn't become a surfaced candidate &mdash;
    so the failure modes are auditable rather than discarded. The counts sum to the
    gene total.
  </p>
  <div class="table-wrap">
  <table>
    <thead><tr><th>disposition</th><th>genes</th><th>share</th></tr></thead>
    <tbody>
    {% for d in taxonomy_counts %}
      <tr {% if d.disposition == 'surfaced' %}class="top"{% endif %}>
        <td>
          {% if d.disposition == 'surfaced' %}<span class="badge badge--ok"><span class="badge__glyph" aria-hidden="true">&#10003;</span>{{ d.disposition }}</span>
          {% else %}<code>{{ d.disposition }}</code>{% endif %}
        </td>
        <td class="num">{{ d.count }}</td>
        <td class="num">{{ d.pct }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <div class="note"><span class="note__glyph" aria-hidden="true">&#8212;</span><div class="note__body"><p style="margin:0">Full per-gene table: <code>taxonomy/failure_taxonomy.parquet</code>.</p></div></div>
</section>
{% endif %}

<section id="provenance">
  <h2>Provenance</h2>
  <p>
    Every stage's tool, version, license, inputs (with SHA-256), and outputs
    (with SHA-256). The full PROV-O JSON-LD is in
    <code>run_manifest.jsonld</code> at the run root.
  </p>
  {% if stages %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr><th>stage</th><th>tool</th><th>version</th><th>license</th><th>status</th><th>notes</th></tr>
    </thead>
    <tbody>
    {% for s in stages %}
      <tr>
        <td><strong>{{ s.name }}</strong></td>
        <td><code>{{ s.tool.name }}</code></td>
        <td>{{ s.tool.version }}</td>
        <td>{{ s.tool.license }}</td>
        <td>
          {% if s.status == 'completed' %}<span class="badge badge--ok"><span class="badge__glyph" aria-hidden="true">&#10003;</span>{{ s.status }}</span>
          {% elif s.status == 'failed' %}<span class="badge badge--err">{{ s.status }}</span>
          {% else %}<span class="badge badge--info">{{ s.status }}</span>{% endif %}
        </td>
        <td>{{ s.notes or '' }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="note"><span class="note__glyph" aria-hidden="true">&#8212;</span><div class="note__body"><p style="margin:0">No manifest stages found.</p></div></div>
  {% endif %}
</section>

<section id="limitations">
  <h2>Limitations</h2>
  <p>The honest scope of expression-based discovery — read before trusting a candidate:</p>
  <ul>
    {% for lim in limitations %}
    <li><strong>{{ lim.title }}.</strong> {{ lim.body }}</li>
    {% endfor %}
  </ul>
</section>

<section>
  <h2>How to read this report</h2>
  <ul>
    <li><strong>Candidate targets</strong> are ranked by the combined
        differential-expression score &pi; = log2FC &times; &minus;log10(padj).
        Structure availability does not affect that rank: it selects which of
        the top-ranked candidates can be carried into the GPU half, because a
        design needs a structure to design against.</li>
    <li><strong>Epitopes</strong> become the input to <code>bindsight design</code>
        once SURFACE-Bind data is populated.</li>
    <li><strong>Provenance</strong> shows what ran. Every entry's
        SHA-256 hashes are in <code>run_manifest.jsonld</code>.</li>
    <li><strong>Limitations</strong> states what expression-based discovery can and
        cannot establish — candidates are hypotheses, not validated targets.</li>
  </ul>
</section>

<footer>
  Generated by <a href="https://github.com/mikhaeelatefrizk/bindsight"><code>bindsight</code></a>.
  Cite the upstream tools you used (see <code>LICENSING.md</code>).
</footer>

</main>
{% if structure_ids %}
{# Inlined, not linked: this file has to work with no server and no siblings.
   The viewer is the same one bindsight ui and the documentation site load. #}
<script>{{ viewer_lib|safe }}</script>
<script>window.BINDSIGHT_STRUCTURES = {{ structures_json|safe }};</script>
<script>{{ viewer_js|safe }}</script>
{% endif %}
</body>
</html>
