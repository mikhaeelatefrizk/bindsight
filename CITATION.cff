cff-version: 1.2.0
message: "If you use bindsight in your research, please cite it as below."
title: "bindsight: a reproducible bridge from RNA-seq to de novo protein binder design"
abstract: >-
  bindsight is an open-source Python package that produces ranked de novo protein
  binder candidates directly from bulk RNA-seq counts, using an
  opinionated pipeline that joins differential expression analysis, the human
  surfaceome (SURFY + SURFACE-Bind), AlphaFoldDB structures, deep-learning
  binder design (RFdiffusion + ProteinMPNN, BindCraft, or BoltzGen), and
  affinity validation (Boltz-2, Chai-1r, or AF2-IG), with end-to-end
  PROV-O / RO-Crate provenance.
type: software
authors:
  - given-names: "Mikhaeel"
    family-names: "Wahba"
    name-particle: "Atef Rizk"
    email: "mikhaeelatefrizk@proton.me"
    affiliation: "Independent researcher"
    orcid: "https://orcid.org/0009-0006-1069-9558"
repository-code: "https://github.com/mikhaeelatefrizk/bindsight"
url: "https://github.com/mikhaeelatefrizk/bindsight"
# No DOI: this software is not archived. GitHub's "Cite this repository" button
# reads this file, so an identifier here goes straight into a reader's
# bibliography -- which is why a placeholder must not sit in it.
license: AGPL-3.0-or-later
