* text=auto eol=lf

*.py text diff=python
*.md text
*.yaml text
*.yml text
*.toml text
*.cff text
Snakefile text

# Binary-y data
*.parquet binary
*.tar.gz binary
*.gz binary
*.zip binary
*.cif binary
*.pdb binary

# Recorded evidence is checksum-addressed: retain its exact archived bytes.
benchmarks/numerical_validation/** -text whitespace=cr-at-eol
docs/audits/** -text whitespace=cr-at-eol
# R's captured session/log output intentionally pads its printed columns.
benchmarks/numerical_validation/reference/**/session-info.txt whitespace=-blank-at-eol
benchmarks/numerical_validation/reference/setup-session-info.txt whitespace=-blank-at-eol
benchmarks/numerical_validation/reference/**/execution.log whitespace=-blank-at-eol
